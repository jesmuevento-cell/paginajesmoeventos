rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jesmuevento@gmail.com' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isJury() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'juri' ||
        exists(/databases/$(database)/documents/jurados/$(request.auth.uid))
      );
    }

    function isEditor() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'editor'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Candidatos (Candidates)
    // Inscrições abertas e consulta acessível por código/BI/email
    match /candidatos/{candidatoId} {
      allow read: if true;
      allow create, update: if isValidId(candidatoId) &&
        request.resource.data.nomeCompleto is string &&
        request.resource.data.bi is string &&
        request.resource.data.email is string &&
        request.resource.data.codigoInscricao is string;
      allow delete: if true;
    }

    // Notícias (News)
    match /noticias/{noticiaId} {
      allow read, write: if true;
    }

    // Etapas (Stages)
    match /etapas/{etapaId} {
      allow read, write: if true;
    }

    // Galeria (Gallery)
    match /galeria/{galeriaId} {
      allow read, write: if true;
    }

    // Avaliações (Jury evaluations)
    match /avaliacoes/{avaliacaoId} {
      allow read, write: if true;
    }

    // Configurações (Settings)
    match /configuracoes/{configId} {
      allow read, write: if true;
    }

    // Utilizadores Registados (Registered App Users)
    match /usuarios/{userId} {
      allow read, write: if true;
    }

    // Admins metadata collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Jurados metadata collection
    match /jurados/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
